# ===========================
# PRISM — Environment Variables
# Copy this file to .env and fill in your values
# ===========================

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://prism:prism_secret@localhost:5432/prism_dev
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism_secret
POSTGRES_DB=prism_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Dataset Paths ----
DATASET_PATH=./datasets
COUGHVID_PATH=./datasets/raw/coughvid
COSWARA_PATH=./datasets/raw/coswara
ICBHI_PATH=./datasets/raw/icbhi

# ---- Model Paths ----
MODEL_PATH=./models/checkpoints
CHECKPOINT_DIR=./models/checkpoints

# ---- FAISS Vector Store ----
FAISS_INDEX_PATH=./vector_store

# ---- Audio Processing ----
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=1
MEL_N_MELS=128
MEL_N_FFT=2048
MEL_HOP_LENGTH=512

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ---- Frontend (Streamlit) ----
STREAMLIT_PORT=8501
